{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jy-web-remake.local/schema/controlled-result-v1.json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "kind": {
          "const": "battle"
        },
        "outcome": {
          "enum": [
            "victory",
            "defeat",
            "escape"
          ]
        }
      },
      "required": [
        "schemaVersion",
        "requestId",
        "kind",
        "outcome"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "kind": {
          "const": "animation"
        },
        "outcome": {
          "const": "completed"
        }
      },
      "required": [
        "schemaVersion",
        "requestId",
        "kind",
        "outcome"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "kind": {
          "const": "transition"
        },
        "outcome": {
          "const": "completed"
        }
      },
      "required": [
        "schemaVersion",
        "requestId",
        "kind",
        "outcome"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "kind": {
          "const": "selection"
        },
        "selectedId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*:[a-z0-9][a-z0-9._/-]*$",
          "maxLength": 160
        }
      },
      "required": [
        "schemaVersion",
        "requestId",
        "kind",
        "selectedId"
      ],
      "additionalProperties": false
    }
  ]
}
