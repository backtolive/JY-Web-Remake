{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jy-web-remake.local/schema/unified-session-save-v4.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 4
    },
    "runtimeVersion": {
      "const": "0.4.0"
    },
    "host": {
      "type": "object",
      "properties": {
        "content": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "kind": {
                "enum": [
                  "base",
                  "mod"
                ]
              },
              "priority": {
                "type": "integer"
              }
            },
            "required": [
              "id",
              "version",
              "sha256",
              "kind",
              "priority"
            ],
            "additionalProperties": false
          },
          "maxItems": 128
        },
        "settings": {
          "type": "object",
          "maxProperties": 128,
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]*$"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1024
              },
              {
                "type": "boolean"
              },
              {
                "type": "number"
              }
            ]
          }
        }
      },
      "required": [
        "content",
        "settings"
      ],
      "additionalProperties": false
    },
    "controlled": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*$",
          "maxLength": 80
        },
        "version": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "mode": {
          "enum": [
            "world",
            "controlled"
          ]
        },
        "game": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "mapId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9.-]*:[a-z0-9][a-z0-9._/-]*$",
              "maxLength": 160
            },
            "x": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "y": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "rngState": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            },
            "flags": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9.-]*:[a-z0-9][a-z0-9._/-]*$",
                "maxLength": 160
              },
              "additionalProperties": {
                "type": "boolean"
              },
              "maxProperties": 10000
            },
            "inventory": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9.-]*:[a-z0-9][a-z0-9._/-]*$",
                "maxLength": 160
              },
              "additionalProperties": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              },
              "maxProperties": 10000
            },
            "cursor": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "properties": {
                    "eventId": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9.-]*:[a-z0-9][a-z0-9._/-]*$",
                      "maxLength": 160
                    },
                    "pc": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000
                    },
                    "waiting": {
                      "enum": [
                        "dialogue",
                        "choice",
                        null
                      ]
                    }
                  },
                  "required": [
                    "eventId",
                    "pc",
                    "waiting"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "mapId",
            "x",
            "y",
            "rngState",
            "flags",
            "inventory",
            "cursor"
          ],
          "additionalProperties": false
        },
        "event": {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "const": 2
            },
            "decision": {
              "$ref": "https://jy-web-remake.local/schema/decision-state-v1.json"
            },
            "cursor": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "properties": {
                    "eventId": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9.-]*:[a-z0-9][a-z0-9._/-]*$",
                      "maxLength": 160
                    },
                    "pc": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "waiting": {
                      "enum": [
                        "dialogue",
                        "choice",
                        "external"
                      ]
                    }
                  },
                  "required": [
                    "eventId",
                    "pc",
                    "waiting"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "rngState": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            },
            "nextRequest": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            },
            "pending": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "properties": {
                    "schemaVersion": {
                      "const": 1
                    },
                    "requestId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "command": {
                      "$ref": "https://jy-web-remake.local/schema/controlled-command-v1.json"
                    }
                  },
                  "required": [
                    "schemaVersion",
                    "requestId",
                    "command"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "schemaVersion",
            "decision",
            "cursor",
            "rngState",
            "nextRequest",
            "pending"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "mode",
        "game",
        "event"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "runtimeVersion",
    "host",
    "controlled",
    "state"
  ],
  "additionalProperties": false
}
