{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jy-web-remake.local/schema/save-v1.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runtimeVersion": {
      "const": "0.1.0"
    },
    "content": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "kind": {
            "enum": [
              "base",
              "mod"
            ]
          },
          "priority": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "version",
          "sha256",
          "kind",
          "priority"
        ],
        "additionalProperties": false
      },
      "maxItems": 128
    },
    "settings": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9._-]*$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 1024
          },
          {
            "type": "boolean"
          },
          {
            "type": "number"
          }
        ]
      }
    },
    "state": {
      "type": "object",
      "properties": {
        "mapId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*:[a-z0-9][a-z0-9._/-]*$",
          "maxLength": 160
        },
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "rngState": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "flags": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]*:[a-z0-9][a-z0-9._/-]*$",
            "maxLength": 160
          },
          "additionalProperties": {
            "type": "boolean"
          },
          "maxProperties": 10000
        },
        "inventory": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]*:[a-z0-9][a-z0-9._/-]*$",
            "maxLength": 160
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "maxProperties": 10000
        },
        "cursor": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "eventId": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9.-]*:[a-z0-9][a-z0-9._/-]*$",
                  "maxLength": 160
                },
                "pc": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000
                },
                "waiting": {
                  "enum": [
                    "dialogue",
                    "choice",
                    null
                  ]
                }
              },
              "required": [
                "eventId",
                "pc",
                "waiting"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "mapId",
        "x",
        "y",
        "rngState",
        "flags",
        "inventory",
        "cursor"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "runtimeVersion",
    "content",
    "settings",
    "state"
  ],
  "additionalProperties": false
}
