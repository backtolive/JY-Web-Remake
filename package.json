{
  "name": "jy-web-remake",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @jy/web build",
    "typecheck": "tsc --noEmit && pnpm --filter @jy/web typecheck",
    "test": "node --test tests/unit/*.test.mjs",
    "inventory": "node tools/analyzer/inventory.mjs",
    "schema:check": "node tools/validator/export-schemas.mjs --check",
    "mvp:prepare": "node tools/extractor/prepare-mvp.mjs original/dos",
    "mvp:check": "node tools/validator/check-mvp-readiness.mjs --original original/dos",
    "dev": "pnpm --filter @jy/web dev",
    "preview": "pnpm --filter @jy/web preview"
  },
  "devDependencies": {
    "ajv": "8.17.1",
    "typescript": "5.9.3"
  }
}
